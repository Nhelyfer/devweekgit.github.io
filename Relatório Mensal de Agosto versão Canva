    <script>
        // Dados para os gráficos
        const data = {
            todos: {
                occurrences: 1490,
                area: 9632,
                time: 18,
                pieData: [671, 372, 223, 149, 75],
                barData: [256, 411, 228, 244, 351]
            },
            '1crbm': {
                occurrences: 256,
                area: 1654,
                time: 16,
                pieData: [128, 51, 38, 26, 13],
                barData: [256, 0, 0, 0, 0]
            },
            '2crbm': {
                occurrences: 411,
                area: 2658,
                time: 19,
                pieData: [185, 103, 62, 41, 20],
                barData: [0, 411, 0, 0, 0]
            },
            '3crbm': {
                occurrences: 228,
                area: 1476,
                time: 17,
                pieData: [103, 57, 34, 23, 11],
                barData: [0, 0, 228, 0, 0]
            },
            '4crbm': {
                occurrences: 244,
                area: 1577,
                time: 20,
                pieData: [110, 61, 37, 24, 12],
                barData: [0, 0, 0, 244, 0]
            },
            '5crbm': {
                occurrences: 351,
                area: 2267,
                time: 18,
                pieData: [158, 88, 53, 35, 17],
                barData: [0, 0, 0, 0, 351]
            }
        };

        let currentFilter = 'todos';
        let pieChart, barChart, lineChart;

        // Função para filtrar por CRBM
        function filterByCRBM(crbm) {
            currentFilter = crbm;
            
            // Atualizar botões ativos
            document.querySelectorAll('.crbm-button').forEach(btn => {
                btn.classList.remove('active');
            });
            event.target.classList.add('active');
            
            // Atualizar estatísticas
            const stats = data[crbm];
            document.getElementById('crbm-occurrences').textContent = stats.occurrences.toLocaleString();
            document.getElementById('crbm-area').textContent = stats.area.toLocaleString() + ' ha';
            document.getElementById('crbm-time').textContent = stats.time + ' min';
            
            // Atualizar gráficos
            updateCharts(crbm);
        }

        // Função para atualizar gráficos
        function updateCharts(filter) {
            const stats = data[filter];
            
            // Atualizar gráfico de pizza
            pieChart.data.datasets[0].data = stats.pieData;
            pieChart.update();
            
            // Atualizar gráfico de barras
            barChart.data.datasets[0].data = stats.barData;
            barChart.update();
        }

        // Inicializar gráficos
        function initCharts() {
            // Gráfico de Pizza
            const pieCtx = document.getElementById('pieChart').getContext('2d');
            pieChart = new Chart(pieCtx, {
                type: 'pie',
                data: {
                    labels: ['Incêndio Florestal', 'Queimada Controlada', 'Incêndio Urbano', 'Incêndio Rural', 'Outros'],
                    datasets: [{
                        data: data.todos.pieData,
                        backgroundColor: [
                            '#c0292b',
                            '#dc2626',
                            '#ef4444',
                            '#f87171',
                            '#fca5a5'
                        ],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                padding: 20,
                                font: {
                                    size: 12
                                }
                            }
                        },
                        datalabels: {
                            color: 'white',
                            font: {
                                weight: 'bold',
                                size: 14
                            },
                            formatter: (value, ctx) => {
                                const sum = ctx.dataset.data.reduce((a, b) => a + b, 0);
                                const percentage = ((value / sum) * 100).toFixed(1);
                                return percentage + '%';
                            }
                        }
                    }
                },
                plugins: [ChartDataLabels]
            });

            // Gráfico de Barras
            const barCtx = document.getElementById('barChart').getContext('2d');
            barChart = new Chart(barCtx, {
                type: 'bar',
                data: {
                    labels: ['1º CRBM\nCuritiba', '2º CRBM\nLondrina', '3º CRBM\nCascavel', '4º CRBM\nMaringá', '5º CRBM\nP. Grossa'],
                    datasets: [{
                        label: 'Ocorrências',
                        data: data.todos.barData,
                        backgroundColor: '#c0292b',
                        borderColor: '#991b1b',
                        borderWidth: 1,
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: '#e5e7eb'
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            });

            // Gráfico de Linha
            const lineCtx = document.getElementById('lineChart').getContext('2d');
            lineChart = new Chart(lineCtx, {
                type: 'line',
                data: {
                    labels: ['Sem 1', 'Sem 2', 'Sem 3', 'Sem 4'],
                    datasets: [{
                        label: 'Ocorrências por Semana',
                        data: [298, 342, 287, 320],
                        borderColor: '#c0292b',
                        backgroundColor: 'rgba(192, 41, 43, 0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        pointBackgroundColor: '#c0292b',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2,
                        pointRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: '#e5e7eb'
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            });
        }

        // Animação de revelação
        function revealElements() {
            const reveals = document.querySelectorAll('.reveal');
            
            reveals.forEach(element => {
                const elementTop = element.getBoundingClientRect().top;
                const elementVisible = 150;
                
                if (elementTop < window.innerHeight - elementVisible) {
                    element.classList.add('visible');
                }
            });
        }

        // Event Listeners
        document.addEventListener('DOMContentLoaded', function() {
            // Definir data atual
            document.getElementById('current-date').textContent = new Date().toLocaleDateString('pt-BR');
            
            // Inicializar gráficos
            initCharts();
            
            // Animação inicial
            revealElements();
        });

        window.addEventListener('scroll', revealElements);
    </script>

